# ==========================================
# Google Gemini API Settings
# Get your free key at: https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Aiven for MySQL Cloud Database Configuration
# Obtain credentials from your Aiven Console Overview tab
# ==========================================
DB_HOST=mysql-xxxxxxxx-your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_db_password
DB_NAME=defaultdb

# Path to the downloaded Aiven CA Certificate (placed in project root)
DB_SSL_CA=ca.pem
